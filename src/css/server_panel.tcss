
.row {
    height: 3;
}

.header-row {
    text-style: bold;
    border-bottom: solid $accent;
}

.col-server { width: 30; content-align: left middle; }
.col-type { width: 10; content-align: left middle; }
.col-status { width: 15; content-align: left middle; }
.col-cpu { width: 7; content-align: left middle; }
.col-memusage { width: 10; content-align: left middle; }
.col-memtotal { width: 12; content-align: left middle; }
.col-uptime { width: 12; content-align: left middle; }
.col-actions { width: 1fr; content-align: left middle; }

.col-server, .col-type, .col-status, .col-cpu, .col-memusage, .col-memtotal, .col-uptime, .col-actions {
    padding: 0 1;
}

.row-btn {
    min-width: 11;
    width: auto;
    height: 3;
    margin-right: 1;
}

.log-entry {
    padding: 0 1;
    height: auto;
}